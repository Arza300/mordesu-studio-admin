// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         Role     @default(VIEWER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Client {
  id                        String   @id @default(cuid())
  name                      String
  platformName               String
  phone                      String
  platformUrl                String
  imageUrl                   String?
  pricePaid                  Int      // سعر تكلفة المنصة (المبلغ المدفوع)
  featuresModificationsPrice Int      @default(0) // سعر المميزات والتعديلات التي طلبها العميل
  createdAt                  DateTime @default(now())
}

model GameProject {
  id          String      @id @default(cuid())
  name        String      // اسم اللعبة
  profits     Int         // أرباح اللعبة
  projectType ProjectType // مشروع خاص أو تابع لمستثمر
  projectLink String?     // رابط المشروع
  createdAt   DateTime    @default(now())
}

model SanaaEarningsEntry {
  id                   String   @id @default(cuid())
  viewsAmount          Int      @default(0)  // أرباح من المشاهدات
  collaborationsAmount Int      @default(0)  // تعاونات
  createdAt            DateTime @default(now())
}

model CourseSalesEntry {
  id           String   @id @default(cuid())
  platformName String   // اسم المنصة
  profits      Int      // الأرباح من المنصة
  createdAt    DateTime @default(now())
}

model OtherProfitsEntry {
  id        String   @id @default(cuid())
  reason    String   // سبب الربح
  profit    Int      // الربح
  createdAt DateTime @default(now())
}

enum ProjectType {
  PRIVATE   // مشروع خاص
  INVESTOR  // تابع لمستثمر
}

enum Role {
  ADMIN
  VIEWER
  USER
}
